  },
  "package_depth_overrides": [
    {
      "paths": [
        "src/components/**"
      ],
      "depth": 3
    },
    {
      "paths": [
        "tests/**"
      ],
      "depth": 3
    }
  ],
  "overrides": [
    {
      "paths": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "tests/**"
      ],
      "profile": "test"
    },
    {
      "paths": [
        "scripts/**"
      ],
      "profile": "script"
    },
    {
      "paths": [
        "**/*registry.ts",
        "**/*Registry.ts",
        "src/components/icon/icon-registry.ts",
        "src/app-menu/**/*.ts"
      ],
      "profile": "registry"
    },
    {
      "paths": [
        "src/**/composables/**/*.ts",
        "src/**/use*.ts"
      ],
      "profile": "composable"
    },
    {
      "paths": [
        "src/components/**/*.vue"
      ],
      "profile": "framework-component"
    },
    {
      "paths": [
        "src/components/docs-browser/RDocsBrowser.vue",
        "src/components/dashboard-builder/RDashboardBuilder.vue",
        "src/components/workflow-designer/RWorkflowDesigner.vue"
      ],
      "profile": "complex-component"
    },
    {
      "paths": [
        "src/components/docs-browser/RDocsBrowser.vue"
      ],
      "profile": "docs-browser"
    }
  ],
  "baseline": {
    "path": ".hrise/frontend-structure-gate-baseline.json"
  },
  "report": {
    "json": ".hrise/frontend-structure-gate-report.json",
    "markdown": ".hrise/frontend-structure-gate-report.md"
  }
}
